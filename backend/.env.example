# Copy this file to .env (in this backend folder) and fill in your values.
# .env is ignored by git, so your passwords never reach GitHub.

DB_URL=jdbc:postgresql://localhost:5432/ticket_booking
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password

# Any long random string (at least 32 characters). Changing it logs everyone out.
JWT_SECRET=replace-this-with-a-long-random-string-of-at-least-32-characters

# Comma-separated emails that get admin rights (create events, check tickets at the door)
ADMIN_EMAILS=admin@example.com

# Must match TASKS_SECRET in Conveyor's .env
TASKS_SECRET=replace-this-with-another-long-random-string

# How long a picked seat is held while the user pays (ISO-8601: PT10M = 10 minutes, PT1M = 1 minute)
HOLD_DURATION=PT10M

# Emails: "outbox" saves them as files in backend/outbox/ (no account needed).
# "smtp" really sends them. For Gmail: turn on 2-Step Verification, create an app password
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
MAIL_MODE=outbox
MAIL_FROM=Ticket Booking <your.address@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
